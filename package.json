{
  "name": "grafic-ecommerce",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3003",
    "prod": "vite --open index-prod.html --host 0.0.0.0 --port 3004",
    "prebuild": "npm run thumbs:all",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3003",
    "thumbs:grid": "node scripts/generate-grid-thumbs.mjs --kind grid --in public/custom_logos/drawings/images_originals/grid --out public/custom_logos/drawings/images_grid --width 320 --quality 72 --incremental",
    "thumbs:grid:force": "node scripts/generate-grid-thumbs.mjs --kind grid --in public/custom_logos/drawings/images_originals/grid --out public/custom_logos/drawings/images_grid --width 320 --quality 72 --incremental --force",
    "thumbs:stripe": "node scripts/generate-grid-thumbs.mjs --kind stripe --in public/custom_logos/drawings/images_originals/stripe --out public/custom_logos/drawings/images_stripe --width 512 --quality 80 --incremental",
    "thumbs:stripe:force": "node scripts/generate-grid-thumbs.mjs --kind stripe --in public/custom_logos/drawings/images_originals/stripe --out public/custom_logos/drawings/images_stripe --width 512 --quality 80 --incremental --force",
    "thumbs:all": "npm run thumbs:grid && npm run thumbs:stripe",
    "thumbs:all:force": "npm run thumbs:grid:force && npm run thumbs:stripe:force",
    "generate-download": "bash scripts/create-download.sh",
    "task:status": "node scripts/task.js status",
    "task:start": "node scripts/task.js start",
    "task:finish": "node scripts/task.js finish",
    "sync-gelato": "node --experimental-modules scripts/sync-gelato-products.js",
    "fetch-blank": "node scripts/fetch-blank-product.js",
    "fetch-store": "node scripts/fetch-store-product.js",
    "prepare": "husky",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "contact-sheet:capture": "node scripts/contact-sheet-capture.mjs",
    "site-map:build": "node scripts/build-site-map.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/react": "^10.56.0",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-helmet": "^6.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.0",
    "remark-gfm": "^4.0.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "lighthouse": "^13.4.1",
    "netlify-cli": "^26.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "three": "^0.169.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "web-vitals": "^6.2.1"
  }
}
